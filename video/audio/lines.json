[
  { "id": "s01", "at": 0.4, "text": "Claude Code、Codex……这么多编程助手，想一起接上七牛？" },
  { "id": "s02", "at": 6.4, "text": "现在，一条命令就够了。" },
  { "id": "s03", "at": 10.4, "text": "工具名、API Key、模型，一口气写完，回车，搞定！" },
  { "id": "s04", "at": 17.8, "text": "换个工具？只改第一个词。想一次配完？写 all。" },
  { "id": "s05", "at": 25.3, "text": "想慢慢挑？不带参数，直接进向导。" },
  { "id": "s06", "at": 30.3, "text": "验 Key、勾工具、挑模型，一步一步来。" },
  { "id": "s07", "at": 37.6, "text": "改之前，原文件先备份。" },
  { "id": "s08", "at": 43.3, "text": "十三款工具，一个七牛，全部接上！" },
  { "id": "s09", "at": 50.8, "text": "打开 Claude Code，还是熟悉的界面，背后已经是七牛。" },
  { "id": "s10", "at": 60.4, "text": "出问题跑 doctor，想撤销就 restore。" },
  { "id": "s11", "at": 66.0, "text": "一条命令，现在就试试吧！" },
  { "id": "s12", "at": 71.0, "text": "npx qiniu-coding-helper。" }
]
